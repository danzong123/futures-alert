# ============================================================
# Futures Alert System - Configuration Template (GitHub Actions)
# ============================================================
# For GitHub Actions: set PUSHPLUS_TOKEN as a repository secret.
# The workflow replaces PUSHPLUS_TOKEN_PLACEHOLDER with the secret.
# All other values are production-ready and LOCKED.

wechat:
  provider: pushplus
  pushplus_token: "PUSHPLUS_TOKEN_PLACEHOLDER"
  wecom_webhook: ""

monitor:
  check_interval_minutes: 5     # GitHub Actions runs on cron, this is for safety
  trading_only: false            # cron already handles trading hours
  contracts: watchlist
  kline_period: "15"
  kline_tail: 60

# Watchlist: empty = all main contracts
watchlist:

# Core data table settings
data_table:
  range_period: 30
  swing_daily_bars: 20
  core_indicators: ["rsi", "macd_bar"]

# Signal detection (band reversal, high conviction swing trading)
strategy:
  breakout_tolerance: 0.003
  cooldown_minutes: 300         # 5 hours between alerts per symbol per direction
  min_alert_score: 40
  bull_min_alert_score: 45
  trend_filter_enabled: true
  volume_ratio_min: 1.0
  atr_filter_enabled: true
  atr_min_pct: 0.002
  atr_max_pct: 0.08

# Trade limits
trade_limits:
  daily_max_trades: 3
  daily_max_alerts: 3
  max_concurrent_positions: 1
  min_risk_reward: 1.5

# Trade suggestion parameters
trade_suggestions:
  atr_stop_multiplier: 1.5
  atr_target_1_multiplier: 1.0
  atr_target_2_multiplier: 1.0

# Push notification settings
notify:
  include_indicators: true
  include_global_context: true
  max_alerts_per_batch: 3
  single_send: true
  retry_count: 1
  max_pushes_per_minute: 3
  push_log_level: minimal
